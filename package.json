{
  "name": "douyu-desktop",
  "version": "0.8.6",
  "private": true,
  "description": "Multi-room Douyu desktop client with danmaku and task center",
  "author": "douyu-desktop",
  "main": "./out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/dev.mjs preview",
    "package": "npm run build && electron-builder --win nsis",
    "package:dir": "npm run build && electron-builder --win dir",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:boundaries && npm run test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "blueimp-md5": "^2.19.0",
    "hls.js": "^1.7.3",
    "mpegts.js": "^1.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/blueimp-md5": "^2.18.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
